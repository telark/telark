# **/ patterns also match the _local/ shared-module copies that
# scripts/local-build-push.sh adds to its temporary build context.
.git
.gitignore
.dockerignore
Dockerfile
go.work
go.work.sum
.env
.env.*

# Docs
**/*.md

# Tests, coverage and build artifacts
**/tests/
**/testdata/
**/*_test.go
coverage.*
**/*.out
*.coverprofile
*.prof
*.test

# IDE and editor files
.idea/
.vscode/
.cursor/
.claude/
*.iml
*.sublime*
*.swp
.DS_Store
