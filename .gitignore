dist
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
*/local*
/reports/*

# Packaged charts (generated by the chart release pipeline)
charts/releases/

# Vendored subchart packages — build artifacts, rebuilt via `make deps`
# (helm dependency build). Chart.lock is committed; the .tgz are not.
charts/*/charts

# Agent skills ship; local agent notes (.claude/LOCAL-*) and the dev-cluster skill stay local
.claude/*
!.claude/skills/
.claude/skills/deploy-dev-cluster/

# Local-only github actions workflows
.github/workflows/local-*

