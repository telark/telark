### Step 2 — Replace prewarm scheduling with leader loop

The prewarm leader loop:
- Gates execution behind leader election.
- Instead of processing all applications inline, enqueues each
  application as a message in the Redis Stream for the consumer
  workers to process.
- The actual per-application work (change detection, snapshot,
  rollback) is performed by the consumer workers (Part 7).

```go
func runPrewarmLeaderLoop(
    ctx context.Context,
    coord *CoordinationBundle,
    replicaID string,
    prewarmInterval time.Duration,
) {
    electionTicker := time.NewTicker(coord.Config.ElectionRenewInterval)
    prewarmTicker  := time.NewTicker(prewarmInterval)
    defer electionTicker.Stop()
    defer prewarmTicker.Stop()

    isLeader := false

    if ok, _ := coord.Election.Campaign(ctx); ok {
        isLeader = true
        log(constants.LogElectionWon, replicaID)
    }

    for {
        select {

        case <-electionTicker.C:
            if isLeader {
                ok, err := coord.Election.Renew(ctx)
                if !ok || err != nil {
                    isLeader = false
                    log(constants.LogElectionLost, replicaID)
                }
            } else {
                if ok, _ := coord.Election.Campaign(ctx); ok {
                    isLeader = true
                    log(constants.LogElectionWon, replicaID)
                }
            }

        case <-prewarmTicker.C:
            if !isLeader {
                log(constants.LogPrewarmLeaderSkip)
                continue
            }
            func() {
                defer func() {
                    if r := recover(); r != nil {
                        log(constants.LogPrewarmLeaderPanic, r)
                    }
                }()
                enqueueApplicationBatch(ctx, coord)
            }()

        case <-ctx.Done():
            if isLeader {
                coord.Election.Resign(ctx)
            }
            return
        }
    }
}
```

