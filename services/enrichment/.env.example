# Redis (same as release-manager: REDIS_HOST + REDIS_PORT, or set REDIS_URL to override)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# Ollama (in-cluster use same host pattern as release-manager, e.g. http://plsyro-ollama:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

CACHE_TTL=86400
LOG_LEVEL=INFO

# Concurrency (1 for ollama, 3 for cloud providers)
NUM_WORKERS=3
REDIS_POOL_SIZE=10

# Observability and shutdown
METRICS_INTERVAL_S=60
DLQ_KEY=enrichment:dlq
WORKER_SHUTDOWN_TIMEOUT_S=30

# Provider: "ollama" (default, air-gapped) | "anthropic" | "groq" | "gemini"
ENRICHMENT_PROVIDER=ollama

# Anthropic (only needed when ENRICHMENT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Groq (only needed when ENRICHMENT_PROVIDER=groq)
# Free API key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Gemini (only needed when ENRICHMENT_PROVIDER=gemini)
# Free API key at aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
