# Redis (REDIS_HOST + REDIS_PORT, or set REDIS_URL to override)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=10

# Model runtime (in-cluster: http://<release>-ollama:11434)
OLLAMA_HOST=http://localhost:11434
OLLAMA_AUTO_PULL=true

LOG_LEVEL=INFO
API_PORT=8080

# Peers
AUTH_SERVICE_URL=http://telark-auth-service:8080
EXPORTER_SERVICE_URL=http://telark-exporter-service:8080
TELARK_SERVICE_TOKEN=

# Analyzer mode: fast (rules + one short narration) or deep (multi-step tool loop)
ANALYZER_MODE=fast
# = the runtime's CPU limit; never above the node's vCPU
ANALYZER_NUM_THREAD=2
ANALYZER_NARRATE_TIMEOUT_SEC=45

# Analyzer caps (defaults shown; deep mode wants ANALYZER_CONTEXT_TOKENS=8192)
ANALYZER_MAX_STEPS=8
ANALYZER_MAX_TOOL_CALLS=8
ANALYZER_TOOL_RESULT_MAX_BYTES=2048
ANALYZER_WALL_SEC=480
ANALYZER_LOOP_TIMEOUT_SEC=120
ANALYZER_EMIT_TIMEOUT_SEC=180
ANALYZER_CHARS_PER_TOKEN=3.5
ANALYZER_CONTEXT_TOKENS=4096
ANALYZER_QUEUE_MAX=100
ANALYZER_AUTO_COOLDOWN_SEC=600
ANALYZER_MANUAL_COOLDOWN_SEC=60
ANALYZER_CONFIG_POLL_SEC=30

# Recommendations (setup reviews; 0 disables the sweep, an analysis run still reviews its app)
ANALYZER_REVIEW_INTERVAL_SEC=7200
ANALYZER_REVIEW_TICK_SEC=120
ANALYZER_REVIEW_APPS_PER_MIN=20
ANALYZER_REVIEW_WORKLOADS_MAX=10
ANALYZER_USAGE_MIN_SAMPLES=12
ANALYZER_USAGE_MIN_SPAN_SEC=43200
ANALYZER_CHANGE_VELOCITY_PER_DAY=20
ANALYZER_CHANGE_RISK_MIN_SPAN_SEC=259200
# Case-insensitive; matched against the app's namespaces and its protection plans' environment names
ANALYZER_PRODUCTION_PATTERN=(^|[-_.])(prod|production|prd)($|[-_.])
