{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "telark chart values",
  "type": "object",
  "additionalProperties": true,
  "required": ["app", "services"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object" },
    "commonAnnotations": { "type": "object" },
    "global": {
      "type": "object",
      "properties": {
        "imagePullSecrets": { "type": "array" }
      }
    },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "path": { "type": "string" },
            "interval": { "type": "string" },
            "labels": { "type": "object" }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "service": { "type": "string" },
        "servicePort": { "type": "integer" },
        "path": { "type": "string" },
        "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
        "annotations": { "type": "object" },
        "tls": { "type": "array" }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array" },
        "service": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "namespace", "image"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["minimal", "standard", "performance"] },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry"],
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
            "pullSecrets": { "type": "array" },
            "kubectl": { "type": "string" }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bootstrap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "admin": { "type": "string", "anyOf": [{ "const": "" }, { "format": "email" }] }
              }
            },
            "passkey": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "origin": { "type": "string" }
              }
            },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": { "type": "string" }
              }
            }
          }
        },
        "kyverno": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "failOpen": { "type": "boolean" }
          }
        },
        "ollama": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "autoPull": { "type": "boolean" },
            "runtimeUrl": { "type": "string" }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "crdGuard": { "$ref": "#/definitions/crdGuard" },
            "networkPolicy": { "$ref": "#/definitions/networkPolicy" },
            "serviceToken": { "$ref": "#/definitions/serviceToken" }
          }
        },
        "crdGuard": { "$ref": "#/definitions/crdGuard" },
        "networkPolicy": { "$ref": "#/definitions/networkPolicy" },
        "serviceToken": { "$ref": "#/definitions/serviceToken" },
        "kubectlImage": { "type": "string" },
        "webhooks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "url", "secret", "events"],
                "properties": {
                  "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                  "url": { "type": "string" },
                  "secret": { "type": "string", "pattern": "^whsec_[A-Za-z0-9+/]{32,}={0,2}$" },
                  "previousSecret": { "type": "string", "pattern": "^(whsec_[A-Za-z0-9+/]{32,}={0,2})?$" },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "enum": ["rollback.completed", "plan.approval.requested", "plan.approval.decided", "incident.critical"] }
                  },
                  "allowPrivate": { "type": "boolean" }
                },
                "if": { "properties": { "allowPrivate": { "const": true } }, "required": ["allowPrivate"] },
                "then": { "properties": { "url": { "pattern": "^https?://(\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*\\.?)(:[0-9]{1,5})?([/?#]([A-Za-z0-9._~!$&'()*+,;=:@/?#-]|%[0-9A-Fa-f]{2})*)?$" } } },
                "else": { "properties": { "url": { "pattern": "^https://(\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*\\.?)(:[0-9]{1,5})?([/?#]([A-Za-z0-9._~!$&'()*+,;=:@/?#-]|%[0-9A-Fa-f]{2})*)?$" } } }
              }
            }
          }
        },
        "selfMonitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "storageClass": { "type": "string" },
            "snapshotsSize": { "type": "string" },
            "reportsSize": { "type": "string" }
          }
        },
        "serviceDefaults": {
          "type": "object",
          "properties": {
            "port": { "type": "integer" },
            "serviceType": { "type": "string" },
            "replicas": { "type": "integer", "minimum": 0 },
            "terminationGracePeriodSec": { "type": "integer" },
            "nodeSelector": { "type": "object" },
            "tolerations": { "type": "array" },
            "affinity": { "type": "object" },
            "autoscaling": { "$ref": "#/definitions/autoscaling" }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["enabled", "name", "repository", "version", "category"],
        "properties": {
          "enabled": { "type": "boolean" },
          "name": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "replicas": { "type": "integer", "minimum": 0 },
          "includeResources": { "type": "boolean" },
          "includeHealthCheck": { "type": "boolean" },
          "includeSecurity": { "type": "boolean" },
          "useRedis": { "type": "boolean" },
          "useNatsCreds": { "type": "boolean" },
          "serviceToken": { "type": "boolean" },
          "natsUser": { "type": "string", "enum": ["publisher", "consumer"] },
          "automountServiceAccountToken": { "type": "boolean" },
          "podSecurityContext": { "type": "object" },
          "containerSecurityContext": { "type": "object" },
          "nodePort": { "type": "integer" },
          "env": { "type": "object" },
          "pdb": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "minAvailable": { "type": ["integer", "string"] },
              "maxUnavailable": { "type": ["integer", "string"] }
            }
          },
          "autoscaling": { "$ref": "#/definitions/autoscaling" },
          "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "create": { "type": "boolean" },
              "name": { "type": "string" },
              "annotations": { "type": "object" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "crdGuard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "enforce": { "type": "boolean" },
        "extraAllowedUsers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "serviceToken": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "envVar": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "existingSecret": { "type": "string" }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  }
}
