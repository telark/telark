```go
type LockClient struct {
    redis *redis.Client
}

func NewLockClient(r *redis.Client) *LockClient

// Acquire attempts to acquire the lock using SET NX PX.
// Non-blocking — returns false immediately if already held.
func (c *LockClient) Acquire(
    ctx context.Context,
    key, value string,
    ttl time.Duration,
) (bool, error)

// Release releases the lock only if the current holder value matches.
// Uses WATCH + MULTI/EXEC:
// WATCH key → GET key → if matches → MULTI → DEL key → EXEC
// If the transaction fails, treat as already released — not an error.
func (c *LockClient) Release(
    ctx context.Context,
    key, value string,
) error

// Extend resets the lock TTL only if the current holder value matches.
// Uses WATCH + MULTI/EXEC:
// WATCH key → GET key → if matches → MULTI → PEXPIRE key ttl → EXEC
// Returns false if key does not exist or value does not match —
// caller must abort the operation immediately.
func (c *LockClient) Extend(
    ctx context.Context,
    key, value string,
    ttl time.Duration,
) (bool, error)
